{
  "name": "@duskmoth-dev/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Duskmoth: private Solana transfers and wallet privacy scoring",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server/server.js",
    "start": "node server/server.js",
    "serve": "NODE_ENV=production node server/server.js",
    "setup:circuits": "node scripts/copy-circuits.js",
    "build:live": "vite build --config live/vite.config.js",
    "build": "pnpm run build:live && pnpm run setup:circuits",
    "check": "node scripts/check-mainnet.js",
    "test:screening": "node --test server/lib/screening.test.js",
    "test": "node --test server/lib/*.test.js test/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@lightprotocol/hasher.rs": "0.2.1",
    "@solana/web3.js": "1.99.0",
    "bs58": "6.0.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "gsap": "3.12.5",
    "lenis": "1.1.13",
    "privacycash": "1.3.1",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@fontsource/bodoni-moda": "5.3.0",
    "@fontsource/cedarville-cursive": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "vite": "8.3.5",
    "vite-plugin-node-polyfills": "0.28.0"
  },
  "author": {
    "name": "Duskmoth",
    "email": "hello@duskmoth.xyz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/duskmoth-dev/duskmoth.git"
  }
}
