{
  "name": "@duskmoth-dev/app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Duskmoth: private Solana transfers and wallet privacy scoring",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch server/server.js",
    "start": "node server/server.js",
    "serve": "NODE_ENV=production node server/server.js",
    "setup:circuits": "node scripts/copy-circuits.js",
    "build:live": "vite build --config live/vite.config.js && vite build --config live/pass.vite.config.js && vite build --config live/magicblock.vite.config.js",
    "build": "pnpm run build:live && pnpm run setup:circuits",
    "check": "node scripts/check-mainnet.js",
    "test:screening": "node --test server/lib/screening.test.js",
    "test": "node --test server/lib/*.test.js test/*.test.mjs",
    "test:pass-client": "node --test live/burn-transaction.test.mjs live/test-pass-client.mjs",
    "test:pass-database": "PASS_DATABASE_TEST=true node --test server/lib/pass-postgres.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@cloudflare/blindrsa-ts": "0.4.6",
    "@lightprotocol/hasher.rs": "0.2.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.17.3",
    "@solana/web3.js": "3.2.0",
    "bs58": "6.0.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "fastestsmallesttextencoderdecoder": "1.0.22",
    "gsap": "3.12.5",
    "lenis": "1.1.13",
    "pg": "8.23.1",
    "privacycash": "1.3.3",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@fontsource/bodoni-moda": "5.3.0",
    "@fontsource/cedarville-cursive": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "vite": "8.3.5",
    "vite-plugin-node-polyfills": "0.28.0"
  },
  "packageManager": "pnpm@10.26.1",
  "author": {
    "name": "Duskmoth",
    "email": "hello@duskmoth.xyz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/duskmoth-dev/duskmoth.git"
  },
  "homepage": "https://duskmoth.xyz",
  "bugs": {
    "url": "https://github.com/duskmoth-dev/duskmoth/issues"
  },
  "pnpm": {
    "overrides": {
      "bigint-buffer": "file:vendor/bigint-buffer",
      "toml": "5.0.1",
      "underscore": "1.13.8",
      "zod": "4.6.7",
      "body-parser@^2": "2.4.0",
      "uuid@^8": "11.1.1",
      "undici@^7": "7.30.1",
      "fast-uri@^3": "3.1.9",
      "qs@^6": "6.17.1",
      "esbuild": "0.28.2",
      "js-yaml": "4.3.2"
    }
  }
}
