# ─────────────────────────────────────────────────────────────
# Duskmoth production config · Solana mainnet-beta
# Copy to .env, fill in, then run: npm run check
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8787
# Your public https origin (used for share previews on X / Telegram)
PUBLIC_URL=https://duskmoth.xyz

# ── Real private transfers through Privacy Cash (mainnet) ──
ENABLE_LIVE_SEND=false
# Per-send caps. Start low for your first days live.
MAX_SEND_SOL=1
MAX_SEND_USDC=100
# Browser → /api/relayer on your server → official Privacy Cash relayer
RELAYER_PROXY=true
RELAYER_URL=https://api3.privacycash.org

# ── Sanctions-only screening (required for wallet-approved transfers) ──
# Scorechain Free Sanctions: non-commercial testing, 100 lookups/hour.
SCORECHAIN_API_KEY=

# ── Mainnet RPC + wallet data (strongly recommended) ──
# https://dashboard.helius.dev  → API key. identity / funded-by need a paid plan.
HELIUS_API_KEY=
# Only used when HELIUS_API_KEY is empty (public RPC is rate limited)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── AI intent parsing (optional; otherwise an English rule parser) ──
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Safety switches: keep these false in public deployments ──
ALLOW_DEMO_WALLET=false
ALLOW_UNSIGNED_SCORE=false

# Moth Pass: ordinary Duskmoth use never requires this token.
DMOTH_MINT=9ueEeBuYUc9X1GrNCyWHbKGnHJq1kaD2nvDapDsMpump
PASS_PRICE_DMOTH=50000
PASS_MAX_PER_BURN=50
PASS_BURN_MAX_AGE_HOURS=72
# Optional RSA-PSS SHA-384 private JWK. Keep this secret; back it up securely.
# Without it, a mode-0600 key is generated in the pass data directory.
PASS_PRIVATE_JWK=
# Production must use a persistent, single-writer directory for keys and ledgers.
# Do not set this true on an ephemeral or independently replicated filesystem.
PASS_STATE_DURABLE=false
# Use PostgreSQL for shared, restart-safe production state. Schema is applied
# through the normal database/publish flow, never by the application at startup.
PASS_STORAGE=postgres
# DATABASE_URL and a stable SESSION_SECRET (32+ characters) belong in Secrets.
# Never rotate SESSION_SECRET without re-encrypting the existing issuer key.
PASS_DATA_DIR=
# Development only. Production ignores this flag. Demo keys are separate.
ALLOW_DEMO_PASSES=false
# Only enable embedding in an isolated development preview, never production.
ALLOW_EMBEDDED_PREVIEW=false
